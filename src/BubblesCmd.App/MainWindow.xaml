<Window x:Class="BubblesCmd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bubbles CMD 0.0.4"
        Height="820"
        Width="1320"
        MinHeight="640"
        MinWidth="960"
        Icon="Assets/bubbles.ico"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="18"
                Padding="18"
                CornerRadius="18"
                Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Bubbles CMD" />
                    <TextBlock Margin="0,6,16,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Real Windows shells hosted through ConPTY with native profiles for cmd.exe, Windows PowerShell, PowerShell 7, WSL, and detected developer environments." />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="820">
                    <ComboBox x:Name="ProfileComboBox"
                              Width="280"
                              Foreground="#111827"
                              Background="#FFFFFF"
                              SelectionChanged="ProfileComboBox_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="250">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Profile, Converter={StaticResource ProfileIconConverter}}"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding IconGlyph}"
                                               Grid.Column="1"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#111827"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayName}"
                                               Foreground="#111827"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ShortcutText}"
                                               Foreground="#4B5563"
                                               Margin="14,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="NewTabButton"
                            Click="NewTabButton_OnClick"
                            Content="New Tab" />
                    <Button x:Name="RunAsAdminButton"
                            Click="RunAsAdminButton_OnClick"
                            Content="Run As Admin" />
                    <Button x:Name="DuplicateTabButton"
                            Click="DuplicateTabButton_OnClick"
                            Content="Duplicate" />
                    <Button x:Name="SplitVerticalButton"
                            Click="SplitVerticalButton_OnClick"
                            Content="Split V" />
                    <Button x:Name="SplitHorizontalButton"
                            Click="SplitHorizontalButton_OnClick"
                            Content="Split H" />
                    <Button x:Name="CloseTabButton"
                            Click="CloseTabButton_OnClick"
                            Content="Close Tab" />
                    <Button x:Name="CopyButton"
                            Click="CopyButton_OnClick"
                            Content="Copy" />
                    <Button x:Name="PasteButton"
                            Click="PasteButton_OnClick"
                            Content="Paste" />
                    <Button x:Name="ClearButton"
                            Click="ClearButton_OnClick"
                            Content="Clear" />
                    <Button x:Name="SnippetsButton"
                            Click="SnippetsButton_OnClick"
                            Content="Snippets" />
                    <Button x:Name="CommandsButton"
                            Click="CommandsButton_OnClick"
                            Content="Commands" />
                    <Button x:Name="PaletteButton"
                            Click="PaletteButton_OnClick"
                            Content="More" />
                    <Button x:Name="SettingsButton"
                            Click="SettingsButton_OnClick"
                            Content="Settings" />
                    <TextBox x:Name="SearchTextBox"
                             Width="180"
                             Margin="8,0,0,0"
                             Padding="8,5"
                             Background="{StaticResource PanelAltBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             KeyDown="SearchTextBox_OnKeyDown" />
                    <Button x:Name="FindNextButton"
                            Click="FindNextButton_OnClick"
                            Content="Find" />
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl x:Name="SessionTabControl"
                    Grid.Row="1"
                    Margin="18,0,18,18"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderThickness="0"
                    SelectionChanged="SessionTabControl_OnSelectionChanged" />

        <Border Grid.Row="2"
                Margin="18,0,18,18"
                Padding="16,10"
                CornerRadius="14"
                Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Ready." />
                <TextBlock Grid.Column="1"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Ctrl+Shift+T new tab | Ctrl+Shift+A admin | Ctrl+W close tab | Ctrl+Shift+D dup pane | Ctrl+Shift+P palette | Ctrl+Tab next pane | Ctrl+Shift+Z zoom pane" />
            </Grid>
        </Border>
    </Grid>
</Window>
