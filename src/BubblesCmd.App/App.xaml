<Application x:Class="BubblesCmd.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:BubblesCmd.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <app:ProfileIconConverter x:Key="ProfileIconConverter" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1720" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#16212C" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1E2D3C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5FC9B5" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECF3F9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9AAEC2" />
        <SolidColorBrush x:Key="ControlLightBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlDarkTextBrush" Color="#111827" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ControlDarkTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlLightBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ControlDarkTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlLightBackgroundBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource ControlDarkTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlLightBackgroundBrush}" />
        </Style>
    </Application.Resources>
</Application>
